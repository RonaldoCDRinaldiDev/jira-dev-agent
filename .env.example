# Copie para .env e preencha. NUNCA versione o .env (ja esta no .gitignore).
# Cada usuario conecta o PROPRIO Jira. Nenhum dado fica fora da sua maquina.

# --- Jira (obrigatorio) ---
# URL do seu Jira Cloud, sem barra no final.
JIRA_BASE_URL=https://seu-site.atlassian.net
# E-mail da sua conta Atlassian.
JIRA_EMAIL=voce@exemplo.com
# API token: Atlassian -> Account Settings -> Security -> Create API token.
JIRA_API_TOKEN=cole_seu_token_aqui

# JQL do que voce quer acompanhar. Padrao: tudo que esta no seu nome.
JIRA_JQL=assignee = currentUser() ORDER BY updated DESC

# --- Servidor ---
PORT=7777

# --- Polling ---
POLL_MINUTES=5
LOOKBACK_MINUTES=20
FEED_MAX=300

# --- Notificacao nativa do SO (1 liga, 0 desliga) ---
NOTIFY=1

# --- Timesheet (opcional) ---
# Repositorios locais cuja branch (ex.: feature/ABC-123) indica a task ativa. Separe por virgula.
TIMESHEET_REPOS=
# Acima de quantos segundos ocioso o tempo NAO conta.
IDLE_MAX_SEC=180
# Ao commitar na branch da task, lanca as horas no Jira automaticamente (1 liga, 0 desliga).
AUTO_LOG_ON_COMMIT=0

# --- Code review (opcional) ---
# Status do Jira que indicam que voce e o reviewer. Separe por virgula.
REVIEW_STATUSES=Code Review,In Review,Review,Em Revisao,Revisao
# Campo customizado do reviewer (ex.: customfield_10050). Vazio = descobrir sozinho.
REVIEWER_FIELD=
# Review APROVADO (aprovar+mergear): status destino + resolucao preenchida na transicao.
REVIEW_DONE_STATUS=Pending Deploy
REVIEW_RESOLUTION=Concluído
# Review REPROVADO: status para onde a issue vai.
REVIEW_REJECTED_STATUS=Fail
# Comentario do worklog ao finalizar um code review.
REVIEW_WORKLOG_COMMENT=Code review usando o agente, testes manuais e merge.

# --- Agente de IA (opcional) ---
# Caminho do binario do Claude CLI. Vazio = procurar no PATH.
CLAUDE_BIN=

# --- Politica de portoes do agente ---
# Acoes que EXIGEM seu OK explicito (csv). Vazio = default: plan,diff,commit.
# plan e diff (codigo) sao SEMPRE gated. PR, branch, status e worklog sao
# automaticos por padrao. Ex. para tornar o commit tambem automatico:
# GATED_ACTIONS=plan,diff
GATED_ACTIONS=
